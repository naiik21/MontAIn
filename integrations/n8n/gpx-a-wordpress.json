    {
      "parameters": {
        "jsCode": "const binarios = $('Recuperar Binarios').first().json;\nconst formData = $('Form Trigger').first().json;\nconst mediaId = $input.first().json.id;\n\nreturn [{\n  json: {\n    title: formData.titulo,\n    content: '',\n    status: 'draft',\n    featured_media: mediaId,\n    acf: {\n      distancia_km:         binarios.data[0].distance_km,\n      elevation_gain:       binarios.data[0].elevation_gain,\n      elevation_loss:       binarios.data[0].elevation_loss,\n      max_elevation:        binarios.data[0].max_elevation,\n      min_elevation:        binarios.data[0].min_elevation,\n      max_slope:            binarios.data[0].max_slope,\n      pendiente_media:      binarios.data[0].mean_slope,\n      pct_over_30:          binarios.data[0].pct_over_30,\n      pct_over_40:          binarios.data[0].pct_over_40,\n      pct_over_45:          binarios.data[0].pct_over_45,\n      mean_aspect:          binarios.data[0].mean_aspect,\n      rugosity_mean:        binarios.data[0].rugosity_mean,\n      exposed_pct:          binarios.data[0].exposed_pct,\n      difficulty:           binarios.data[0].difficulty,\n      elevation_chart_data: JSON.stringify(binarios.elevation_plot),\n      ai_description:       binarios.description\n    }\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
