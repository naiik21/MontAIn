    {
      "parameters": {
        "jsCode": "// Rescata el título y la imagen binaria del Form Trigger\n// porque el nodo HTTP anterior los sobreescribe con la respuesta de la API\nconst apiResponse = $input.first().json;\nconst formData = $('Form Trigger').first();\n\nreturn [{\n  json: {\n    ...apiResponse,\n    titulo: formData.json.titulo\n  },\n  binary: {\n    imagen: formData.binary.imagen\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        528
      ],
