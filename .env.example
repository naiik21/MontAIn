# Copiar a .env y rellenar. Todas las variables son opcionales: sin ninguna,
# la API arranca con valores pensados para desarrollo en local.

# --- IA --------------------------------------------------------------------
# Sin clave, la API funciona igual y devuelve description: null (el analisis
# de la ruta no depende de Claude).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-6
# ANTHROPIC_MAX_TOKENS=1000

# --- Red -------------------------------------------------------------------
# Origenes permitidos por CORS, separados por comas. En produccion, el dominio
# del frontend desplegado.
# CORS_ORIGINS=https://montain.vercel.app
# PORT=8000

# --- Limites del endpoint --------------------------------------------------
# MAX_UPLOAD_BYTES=5242880
# MAX_TRACK_POINTS=50000
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=3600

# --- Datos de elevacion ----------------------------------------------------
# Directorio de la cache de tiles SRTM. En produccion, un volumen persistente:
# sin el, cada arranque en frio vuelve a descargarlos.
# SRTM_CACHE_DIR=/app/.srtm-cache
# SRTM_TIMEOUT_SECONDS=30
