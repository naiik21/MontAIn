# Plantilla de configuracion de la API.
#
#   cp .env.example .env
#
# Todas las variables son opcionales: sin ninguna, la API arranca con valores
# pensados para desarrollo en local. Los valores comentados son los que se
# usan por defecto. En produccion se definen en el panel del proveedor
# (Render, Railway...), no en este archivo.
#
# La configuracion del frontend va aparte, en front/.env.example


# --- IA --------------------------------------------------------------------

# Clave de https://console.anthropic.com. Es lo unico que conviene rellenar.
# Sin ella la API funciona igual: analiza la ruta y devuelve description: null.
ANTHROPIC_API_KEY=

# Modelo que redacta la descripcion.
# ANTHROPIC_MODEL=claude-sonnet-5

# Tope de la respuesta. Por debajo de ~1200 las descripciones se cortan.
# ANTHROPIC_MAX_TOKENS=1600


# --- Red -------------------------------------------------------------------

# Dominios que pueden llamar a la API, separados por comas. En produccion, el
# del frontend desplegado. Por defecto: los puertos locales de Astro.
# CORS_ORIGINS=https://montain.vercel.app

# PORT=8000


# --- Limites del endpoint --------------------------------------------------
# Protegen contra abusos y contra el gasto en la API de Anthropic.

# Tamano maximo del GPX subido, en bytes. Por defecto 5 MB.
# MAX_UPLOAD_BYTES=5242880

# Puntos maximos de la traza. El analisis calcula una distancia geodesica por
# cada par consecutivo, asi que una traza enorme bloquea el worker.
# MAX_TRACK_POINTS=50000

# Peticiones por IP y ventana. Por defecto, 10 cada hora (3600 segundos).
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=3600

# Resultados cacheados por hash del archivo: el mismo GPX no se analiza ni se
# vuelve a enviar a Claude dos veces. 0 desactiva la cache.
# ANALYSIS_CACHE_SIZE=128


# --- Datos de elevacion ----------------------------------------------------

# Donde se guardan los tiles SRTM que rellenan las cotas que falten. En
# produccion, un volumen persistente: sin el, cada arranque en frio los vuelve
# a descargar y la primera peticion tarda mucho.
# SRTM_CACHE_DIR=/app/.srtm-cache

# Segundos de espera al descargar un tile.
# SRTM_TIMEOUT_SECONDS=30
